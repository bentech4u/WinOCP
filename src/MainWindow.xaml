<Window Icon="/Assets/WinOCP.ico" x:Class="WinOCP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOCP — OpenShift File Transfer" Width="1440" Height="960" MinWidth="1200" MinHeight="800" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
<DockPanel Background="{DynamicResource PageBrush}">
<DockPanel DockPanel.Dock="Top" Margin="18,8,18,0" LastChildFill="False">
<Image DockPanel.Dock="Left" Width="200" Height="40" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="WinOCP — OpenShift File Transfer" AutomationProperties.Name="WinOCP"><Image.Source><CroppedBitmap SourceRect="34,54,729,147"><CroppedBitmap.Source><BitmapImage UriSource="pack://application:,,,/WinOCP;component/Assets/WinOCP-banner.png"/></CroppedBitmap.Source></CroppedBitmap></Image.Source></Image>
<Button DockPanel.Dock="Left" Content="Connections" Click="ShowConnection"/><Button DockPanel.Dock="Left" Content="Automation" Click="ShowAutomation"/>

<Button DockPanel.Dock="Left" Content="About" Click="ShowAbout"/>
<ComboBox x:Name="ThemeChoice" DockPanel.Dock="Right" Width="110" SelectedIndex="0" SelectionChanged="ThemeChanged" ToolTip="Appearance"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
<TextBlock DockPanel.Dock="Right" Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0"/>
</DockPanel><Grid Margin="18,8,18,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="LoginCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><DockPanel Margin="4,0,4,12"><TextBlock Text="Connect to OpenShift" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="SECURE CLUSTER ACCESS" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
<WrapPanel>
<StackPanel Width="190"><Label Content="Authentication"/><ComboBox x:Name="Auth" SelectedIndex="0" SelectionChanged="AuthChanged"><ComboBoxItem Content="Token"/><ComboBoxItem Content="Username / password"/><ComboBoxItem Content="Kubeconfig"/></ComboBox></StackPanel>
<StackPanel x:Name="ServerField" Width="300"><Label Content="API server"/><TextBox x:Name="Server" Text="https://api.example.com:6443" ToolTip="OpenShift HTTPS API server"/></StackPanel>
<StackPanel x:Name="UsernameField" Width="150" Visibility="Collapsed"><Label Content="Username"/><TextBox x:Name="User" ToolTip="OpenShift username"/></StackPanel>
<StackPanel x:Name="SecretField" Width="230"><Label x:Name="SecretLabel" Content="Token"/><PasswordBox x:Name="Secret" ToolTip="OpenShift token"/></StackPanel>
<Button x:Name="ConfigButton" Content="Choose kubeconfig…" Click="ChooseConfig" Visibility="Collapsed" VerticalAlignment="Bottom"/><Button Content="⌁  Connect" Style="{StaticResource Primary}" Click="Connect" VerticalAlignment="Bottom"/><Button Content="Disconnect" Click="Disconnect" VerticalAlignment="Bottom"/>
</WrapPanel><WrapPanel Margin="4,10,0,0"><CheckBox x:Name="SkipTls" Content="Skip TLS certificate verification" IsChecked="False" VerticalAlignment="Center" ToolTip="Reconnect after changing this option."/><TextBlock Text="  ·  Applies on connect" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></WrapPanel><TextBlock x:Name="ConfigLabel" Visibility="Collapsed" TextWrapping="Wrap" Margin="4,8,4,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
<Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12"><Grid Background="{DynamicResource PageBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#94A3B8" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionTitle" Text="Not connected" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="ConnectionDetail" Text="Open Connections to choose a site" Foreground="{DynamicResource MutedBrush}" Margin="17,5,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><StackPanel Grid.Column="1"><Label Content="Project"/><ComboBox x:Name="Projects" SelectionChanged="ProjectChanged"/></StackPanel><StackPanel Grid.Column="2"><Label Content="Pod"/><ComboBox x:Name="Pods" SelectionChanged="PodChanged"/></StackPanel><StackPanel Grid.Column="3"><Label Content="Container"/><ComboBox x:Name="Containers" SelectionChanged="ContainerChanged"/></StackPanel><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Disconnect" Click="Disconnect"/><Button Content="⟳" FontSize="20" Click="RefreshCluster" ToolTip="Refresh projects" VerticalAlignment="Bottom"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="▣  Local Computer" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10"/><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="↑" Click="LocalUp" ToolTip="Parent folder"/><ComboBox x:Name="LocalLocations" DockPanel.Dock="Left" Width="170" DisplayMemberPath="Label" SelectionChanged="LocationSelected" DropDownOpened="LocationsOpened" ToolTip="Choose a drive or common folder"/><Button DockPanel.Dock="Right" Content="⟳" Click="LocalGo" ToolTip="Go to path / refresh"/><TextBox x:Name="LocalPath" KeyDown="LocalKey"/></DockPanel><TextBlock DockPanel.Dock="Bottom" Margin="4,9,0,0" Foreground="{DynamicResource MutedBrush}" Text="{Binding Items.Count, ElementName=LocalFiles, StringFormat={}{0} items}"/><ListView x:Name="LocalFiles" PreviewMouseRightButtonDown="FileRightClick" ContextMenuOpening="FileMenuOpening" AllowDrop="True" PreviewMouseLeftButtonDown="FileDragStart" PreviewMouseLeftButtonUp="FileDragEnd" PreviewMouseMove="FileDragMove" DragOver="FilesDragOver" Drop="FilesDrop" ToolTip="Drag files to the remote pane to upload. Drop remote files here to download into the current local folder." MouseDoubleClick="LocalOpen" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Header="Name" Width="225" CellTemplate="{StaticResource FileName}"/><GridViewColumn Header="Size (bytes)" Width="100" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="Modified" Width="155" DisplayMemberBinding="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm:ss}"/><GridViewColumn Header="Rights" Width="140" DisplayMemberBinding="{Binding Rights}"/><GridViewColumn Header="Owner" Width="140" DisplayMemberBinding="{Binding Owner}"/><GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding Kind}"/></GridView></ListView.View></ListView></DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="10"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="4,0,0,10"><Image Source="pack://application:,,,/WinOCP;component/Assets/WinOCP-emblem.png" Width="30" Height="24" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="OpenShift cloud sync emblem"/><TextBlock Text="OpenShift Pod" FontSize="18" FontWeight="SemiBold"/></DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="↑" Click="RemoteUp" ToolTip="Parent directory"/><Button DockPanel.Dock="Right" Content="⟳" Click="RemoteGo" ToolTip="Go to path / refresh"/><TextBox x:Name="RemotePath" Text="/" KeyDown="RemoteKey"/></DockPanel><TextBlock DockPanel.Dock="Bottom" Margin="4,9,0,0" Foreground="{DynamicResource MutedBrush}" Text="{Binding Items.Count, ElementName=RemoteFiles, StringFormat={}{0} items}"/><ListView x:Name="RemoteFiles" PreviewMouseRightButtonDown="FileRightClick" ContextMenuOpening="FileMenuOpening" AllowDrop="True" PreviewMouseLeftButtonDown="FileDragStart" PreviewMouseLeftButtonUp="FileDragEnd" PreviewMouseMove="FileDragMove" DragOver="FilesDragOver" Drop="FilesDrop" ToolTip="Drag files to the local pane to download. Drop local files here to upload into the current container directory." MouseDoubleClick="RemoteOpen" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Header="Name" Width="225" CellTemplate="{StaticResource FileName}"/><GridViewColumn Header="Size (bytes)" Width="100" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="Modified" Width="155" DisplayMemberBinding="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm:ss}"/><GridViewColumn Header="Rights" Width="140" DisplayMemberBinding="{Binding Rights}"/><GridViewColumn Header="Owner" Width="140" DisplayMemberBinding="{Binding Owner}"/><GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding Kind}"/></GridView></ListView.View></ListView></DockPanel></Border></Grid>
<StackPanel Grid.Row="4" Margin="0,10,0,0">
<Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6"><Grid><Expander x:Name="TransfersPanel" IsExpanded="True" Expanded="TransfersExpanded" Foreground="{DynamicResource TextBrush}"><Expander.Header><TextBlock Text="Transfers" Height="44" VerticalAlignment="Center" Padding="0,13,0,0"/></Expander.Header>
<DockPanel><ScrollViewer Height="150" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TransferList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Direction}" Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0"><ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding ProgressText}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Speed}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center"/><Button Grid.Column="4" Content="Cancel" Click="CancelTransfer" IsEnabled="{Binding CanCancel}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel>
</Expander><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="TransferFilter" Width="140" SelectedIndex="0" SelectionChanged="TransferFilterChanged"><ComboBoxItem Content="All"/><ComboBoxItem Content="Running"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/></ComboBox><Button Content="Clear history" Click="ClearTransferHistory" ToolTip="Remove Completed and Cancelled transfers; preserve running, queued, and failed entries"/></StackPanel></Grid></Border>
<Border Style="{StaticResource Card}" Padding="10"><Expander x:Name="ActivityPanel" Header="Activity log" IsExpanded="False" Expanded="ActivityExpanded" Foreground="{DynamicResource TextBrush}"><TextBox x:Name="History" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="{DynamicResource InputBrush}"/></Expander></Border>
</StackPanel><DockPanel Grid.Row="5" Margin="4,10,4,0"><TextBlock Text="●" Foreground="#087CFA" Margin="0,0,8,0"/><TextBlock x:Name="Status" Text="Ready · Connect to a cluster to begin" TextWrapping="Wrap"/></DockPanel>
</Grid></DockPanel></Window>
