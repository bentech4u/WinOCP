<Window x:Class="WinOCP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOCP — OpenShift File Transfer" Width="1440" Height="960" MinWidth="1200" MinHeight="800" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
<Grid Background="{DynamicResource PageBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#101D2E"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="24,30,12,28"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="#ED353C" FontSize="46"/><TextBlock FontSize="34" FontWeight="Bold" Margin="0,12,0,0"><Run Text="Win" Foreground="White"/><Run Text="OCP" Foreground="#ED353C"/></TextBlock><TextBlock Text="OpenShift File Transfer" Foreground="#A4B9D0" Margin="0,4,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="20,20"><TextBlock Text="APPEARANCE" Foreground="#A4B9D0" FontSize="10" Margin="4,0,0,8"/><ComboBox x:Name="ThemeChoice" SelectedIndex="0" SelectionChanged="ThemeChanged" Margin="0,0,0,20"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><TextBlock Text="WinOCP  ·  v0.8" Foreground="#A4B9D0"/><TextBlock Text="PORTABLE EDITION" Foreground="#6F8AA6" FontSize="10" Margin="0,6,0,0"/></StackPanel>
<StackPanel><Button Style="{StaticResource Nav}" Background="#124A8C" Foreground="White" Content="⇄    File transfer" Click="ShowFiles"/><Button Style="{StaticResource Nav}" Content="⌁    Connections" Click="ShowConnection"/><Button Style="{StaticResource Nav}" Content="◷    Activity log" Click="ShowHistory"/><Button Style="{StaticResource Nav}" Content="ⓘ    About WinOCP" Click="ShowAbout"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="18,18,18,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border x:Name="LoginCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><DockPanel Margin="4,0,4,12"><TextBlock Text="Connect to OpenShift" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="SECURE CLUSTER ACCESS" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
<WrapPanel>
<StackPanel Width="190"><Label Content="Authentication"/><ComboBox x:Name="Auth" SelectedIndex="0" SelectionChanged="AuthChanged"><ComboBoxItem Content="Token"/><ComboBoxItem Content="Username / password"/><ComboBoxItem Content="Kubeconfig"/></ComboBox></StackPanel>
<StackPanel x:Name="ServerField" Width="300"><Label Content="API server"/><TextBox x:Name="Server" Text="https://api.example.com:6443" ToolTip="OpenShift HTTPS API server"/></StackPanel>
<StackPanel x:Name="UsernameField" Width="150" Visibility="Collapsed"><Label Content="Username"/><TextBox x:Name="User" ToolTip="OpenShift username"/></StackPanel>
<StackPanel x:Name="SecretField" Width="230"><Label x:Name="SecretLabel" Content="Token"/><PasswordBox x:Name="Secret" ToolTip="OpenShift token"/></StackPanel>
<Button x:Name="ConfigButton" Content="Choose kubeconfig…" Click="ChooseConfig" Visibility="Collapsed" VerticalAlignment="Bottom"/><Button Content="⌁  Connect" Style="{StaticResource Primary}" Click="Connect" VerticalAlignment="Bottom"/><Button Content="Disconnect" Click="Disconnect" VerticalAlignment="Bottom"/>
</WrapPanel><WrapPanel Margin="4,10,0,0"><CheckBox x:Name="SkipTls" Content="Skip TLS certificate verification" IsChecked="False" VerticalAlignment="Center" ToolTip="Reconnect after changing this option."/><TextBlock Text="  ·  Applies on connect" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></WrapPanel><TextBlock x:Name="ConfigLabel" Visibility="Collapsed" TextWrapping="Wrap" Margin="4,8,4,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
<Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12"><Grid Background="{DynamicResource PageBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#94A3B8" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionTitle" Text="Not connected" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="ConnectionDetail" Text="Open Connections to choose a site" Foreground="{DynamicResource MutedBrush}" Margin="17,5,8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><StackPanel Grid.Column="1"><Label Content="Project"/><ComboBox x:Name="Projects" SelectionChanged="ProjectChanged"/></StackPanel><StackPanel Grid.Column="2"><Label Content="Pod"/><ComboBox x:Name="Pods" SelectionChanged="PodChanged"/></StackPanel><StackPanel Grid.Column="3"><Label Content="Container"/><ComboBox x:Name="Containers" SelectionChanged="ContainerChanged"/></StackPanel><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Disconnect" Click="Disconnect"/><Button Content="⟳" FontSize="20" Click="RefreshCluster" ToolTip="Refresh projects" VerticalAlignment="Bottom"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="▣  Local Computer" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10"/><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="↑" Click="LocalUp" ToolTip="Parent folder"/><ComboBox x:Name="LocalLocations" DockPanel.Dock="Left" Width="170" DisplayMemberPath="Label" SelectionChanged="LocationSelected" DropDownOpened="LocationsOpened" ToolTip="Choose a drive or common folder"/><Button DockPanel.Dock="Right" Content="⟳" Click="LocalGo" ToolTip="Go to path / refresh"/><TextBox x:Name="LocalPath" KeyDown="LocalKey"/></DockPanel><TextBlock DockPanel.Dock="Bottom" Margin="4,9,0,0" Foreground="{DynamicResource MutedBrush}" Text="{Binding Items.Count, ElementName=LocalFiles, StringFormat={}{0} items}"/><ListView x:Name="LocalFiles" AllowDrop="True" PreviewMouseLeftButtonDown="FileDragStart" PreviewMouseLeftButtonUp="FileDragEnd" PreviewMouseMove="FileDragMove" DragOver="FilesDragOver" Drop="FilesDrop" ToolTip="Drag files to the remote pane to upload. Drop remote files here to download into the current local folder." MouseDoubleClick="LocalOpen" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Header="Name" Width="255" CellTemplate="{StaticResource FileName}"/><GridViewColumn Header="Size (bytes)" Width="100" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding Kind}"/></GridView></ListView.View></ListView></DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="10"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="4,0,0,10"><TextBlock Text="⟳" Foreground="#E6323B" FontSize="22" Margin="0,0,8,0"/><TextBlock Text="OpenShift Pod" FontSize="18" FontWeight="SemiBold"/></DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Left" Content="↑" Click="RemoteUp" ToolTip="Parent directory"/><Button DockPanel.Dock="Right" Content="⟳" Click="RemoteGo" ToolTip="Go to path / refresh"/><TextBox x:Name="RemotePath" Text="/" KeyDown="RemoteKey"/></DockPanel><TextBlock DockPanel.Dock="Bottom" Margin="4,9,0,0" Foreground="{DynamicResource MutedBrush}" Text="{Binding Items.Count, ElementName=RemoteFiles, StringFormat={}{0} items}"/><ListView x:Name="RemoteFiles" AllowDrop="True" PreviewMouseLeftButtonDown="FileDragStart" PreviewMouseLeftButtonUp="FileDragEnd" PreviewMouseMove="FileDragMove" DragOver="FilesDragOver" Drop="FilesDrop" ToolTip="Drag files to the local pane to download. Drop local files here to upload into the current container directory." MouseDoubleClick="RemoteOpen" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Header="Name" Width="300" CellTemplate="{StaticResource FileName}"/><GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Kind}"/></GridView></ListView.View></ListView></DockPanel></Border></Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8"><Button Content="Upload  →" Click="Upload" Style="{StaticResource Primary}" MinWidth="130"/><Button Content="←  Download" Click="Download" MinWidth="130"/><Button Content="Cancel operation" Click="Cancel"/></StackPanel>
<Border Grid.Row="4" Style="{StaticResource Card}" Padding="12"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="2,0,2,6"><TextBlock Text="Activity log" FontWeight="SemiBold"/><TextBlock Text="CONNECTIONS &amp; TRANSFERS" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></DockPanel><TextBox x:Name="History" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="{DynamicResource InputBrush}"/></DockPanel></Border>
<DockPanel Grid.Row="5" Margin="4,10,4,0"><TextBlock Text="●" Foreground="#087CFA" Margin="0,0,8,0"/><TextBlock x:Name="Status" Text="Ready · Connect to a cluster to begin" TextWrapping="Wrap"/></DockPanel>
</Grid></Grid></Window>
