<Window x:Class="WinOCP.ConnectionManager" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOCP — Connection Manager" Width="780" Height="560" MinWidth="740" MinHeight="540" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
<Window.Resources>
<Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="2"/></Style>
<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="2"/></Style>
<Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="2"/></Style>
<Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="2"/></Style>
<Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}"><Setter Property="Padding" Value="2,0,2,3"/><Setter Property="FontSize" Value="12"/></Style>
</Window.Resources>
<Grid Margin="12" Background="{DynamicResource PageBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="2,0,0,10"><TextBlock FontSize="19" FontWeight="Bold"><Run Text="Win"/><Run Text="OCP" Foreground="#ED353C"/></TextBlock><TextBlock Text="  Connection Manager" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="8"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="2,0,0,6"><TextBlock Text="Sites" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="＋" Click="NewSite" ToolTip="New site" HorizontalAlignment="Right" Padding="10,3"/></DockPanel>
<StackPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Label Content="Search"/><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search saved connections"/></StackPanel>
<ListBox x:Name="Sites" SelectionChanged="SiteSelected" MouseDoubleClick="SiteDoubleClick" BorderThickness="0" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="4,7,4,4"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SiteRow" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SiteRow" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SiteRow" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><DockPanel ToolTip="{Binding Server}"><TextBlock Text="▤" Foreground="#6E9DD4" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="10"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="2,0,2,8"><TextBlock Text="Session" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="OpenShift cluster" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
<TabControl x:Name="Editor" Background="{DynamicResource CardBrush}" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
<TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" CornerRadius="12" Padding="10,5" Margin="0,0,4,6"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
<TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,0,0">
<Label Content="Site name"/><TextBox x:Name="SiteName"/>
<Label Content="Cluster API URL" Margin="0,7,0,0"/><TextBox x:Name="ApiUrl" Text="https://api.example.com:6443"/>
<Label Content="Authentication" Margin="0,7,0,0"/><ComboBox x:Name="Method" SelectedIndex="0" SelectionChanged="MethodChanged"><ComboBoxItem Content="Token"/><ComboBoxItem Content="Username / password"/><ComboBoxItem Content="Kubeconfig"/></ComboBox>
<Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="UsernamePanel" Visibility="Collapsed" Width="180" Margin="0,0,6,0"><Label Content="Username"/><TextBox x:Name="Username"/></StackPanel><StackPanel x:Name="SecretPanel" Grid.Column="1"><Label x:Name="CredentialLabel" Content="Token"/><PasswordBox x:Name="Credential"/></StackPanel></Grid>
<StackPanel x:Name="ConfigPanel" Visibility="Collapsed"><Label Content="Kubeconfig file"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseConfig"/><TextBox x:Name="ConfigPath"/></DockPanel></StackPanel>
<CheckBox x:Name="RememberSecret" Content="Save secret for this Windows account" Margin="2,9,2,0" ToolTip="Saved with Windows encryption. Enter the secret again on another PC or Windows account."/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Advanced"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,0,0"><Label Content="Group"/><TextBox x:Name="GroupName" Text="My connections"/><Label Content="Default project (optional)" Margin="0,7,0,0"/><TextBox x:Name="DefaultProject"/><Label Content="Description" Margin="0,7,0,0"/><TextBox x:Name="Description" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="SkipCertificate" Content="Skip TLS certificate verification" Margin="2,12" ToolTip="Bypass server certificate validation for login, browsing, and transfers."/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Notes"><TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/></TabItem>
</TabControl></DockPanel></Border></Grid>
<ScrollViewer Grid.Row="2" MaxHeight="42" VerticalScrollBarVisibility="Auto" Margin="2,6,2,0"><TextBlock x:Name="Feedback" Text="Select a site or create a new one." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></ScrollViewer>
<DockPanel Grid.Row="3" Margin="0,6,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="SaveButton" Content="Save site" Click="SaveSite"/><Button x:Name="DeleteButton" Content="Delete" Click="DeleteSite"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LoginButton" Content="Login  →" Style="{StaticResource Primary}" Padding="18,6" MinWidth="100" Click="Login"/><Button Content="Cancel" Click="CloseManager"/></StackPanel></DockPanel>
<CheckBox Grid.Row="4" x:Name="ShowStartup" Content="Show at startup and after disconnecting" IsChecked="True" Margin="2,8,2,0" FontSize="11" Click="StartupChanged"/>
</Grid></Window>
