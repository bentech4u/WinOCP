<Window Icon="/WinOCP;component/Assets/WinOCP.ico" x:Class="WinOCP.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="About WinOCP" Width="570" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
<Grid Margin="20" Background="{DynamicResource PageBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Image Source="pack://application:,,,/WinOCP;component/Assets/WinOCP-emblem.png" Width="96" Height="96" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" AutomationProperties.Name="WinOCP cloud sync emblem"/>
<StackPanel Grid.Column="1"><TextBlock FontSize="34" FontWeight="Bold"><Run Text="Win"/><Run Text="OCP" Foreground="#ED353C"/></TextBlock><TextBlock Text="OpenShift File Transfer" FontSize="18" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="VersionText" FontSize="14" Margin="0,6,0,10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="A portable Windows client for transferring files between your computer and OpenShift containers." TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
</Grid>
<Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}"/>
<StackPanel Grid.Row="2" Margin="4,14,0,14">
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Developer" Foreground="{DynamicResource MutedBrush}" FontSize="14"/><TextBlock Text="Ben T George" FontSize="14" Margin="0,3,0,0"/></StackPanel></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#4298FF" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Website" Foreground="{DynamicResource MutedBrush}" FontSize="14"/><TextBlock FontSize="14" Margin="0,3,0,0"><Hyperlink NavigateUri="https://bentgeorge.com" RequestNavigate="OpenLink" Foreground="#4298FF">bentgeorge.com ↗</Hyperlink></TextBlock></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="☕" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="#F5CC29" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Support the Project" Foreground="{DynamicResource MutedBrush}" FontSize="14"/><WrapPanel Margin="0,5,0,0"><Button Content="☕  Buy Me a Coffee" Foreground="#F5CC29" BorderBrush="#F5CC29" Background="Transparent" FontWeight="SemiBold" FontSize="14" Click="OpenSupport" Margin="0,0,10,6"/><TextBlock VerticalAlignment="Center" Margin="0,0,0,6"><Hyperlink NavigateUri="https://buymeacoffee.com/bentech4u" RequestNavigate="OpenLink" Foreground="#4298FF">buymeacoffee.com/bentech4u ↗</Hyperlink></TextBlock></WrapPanel></StackPanel></Grid>
</StackPanel>
<Border Grid.Row="3" Height="1" Background="{DynamicResource BorderBrush}"/>
<DockPanel Grid.Row="4" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Primary}" Width="90" IsCancel="True" IsDefault="True" Click="CloseAbout"/><StackPanel VerticalAlignment="Center"><TextBlock Text="WinOCP Community Project" FontSize="15"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}"><Run Text="Built with "/><Run Text="♥" Foreground="#ED353C"/><Run Text=" for the OpenShift community."/></TextBlock></StackPanel></DockPanel>
</Grid></Window>
