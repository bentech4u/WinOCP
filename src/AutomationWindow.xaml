<Window x:Class="WinOCP.AutomationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOCP — Automation" Width="1040" Height="790" MinWidth="880" MinHeight="700" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
<Window.Resources>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="10" Margin="0,2" Background="Transparent" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid Margin="14" Background="{DynamicResource PageBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="4,0,0,12"><TextBlock Text="Automatic file uploads" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ClusterLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><Button DockPanel.Dock="Right" Content="+ New Job" Click="NewJob" Padding="10,6" Style="{StaticResource Primary}"/><TextBlock Text="Job Manager" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Search jobs" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,4,0,0"/><TextBox x:Name="JobSearch" TextChanged="SearchJobs" ToolTip="Search jobs"/></StackPanel><TextBlock x:Name="JobCount" DockPanel.Dock="Bottom" Margin="4,10" Foreground="{DynamicResource MutedBrush}"/><ListBox x:Name="JobsList" SelectionChanged="SelectJob" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="11"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<TabControl Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10">
<TabItem Header="Job Details"><DockPanel><StackPanel DockPanel.Dock="Bottom"><DockPanel Margin="0,10,0,0"><StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="Job status" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeState" Text="Stopped" Foreground="{DynamicResource MutedBrush}" Margin="4"/></StackPanel><WrapPanel HorizontalAlignment="Right"><Button x:Name="StartButton" Content="Start" Style="{StaticResource Primary}" Click="StartJob"/><Button x:Name="PauseButton" Content="Pause" Click="PauseJob"/><Button x:Name="StopButton" Content="Stop" Click="StopJob"/></WrapPanel></DockPanel><TextBlock x:Name="JobStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,8"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="TestButton" Content="Test configuration" Click="Test"/><Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" Click="SaveJob"/><Button x:Name="DeleteButton" Content="Delete" Click="DeleteJob"/><Button Content="Close" Click="CloseWindow"/></WrapPanel></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="SettingsPanel"><Label Content="Automation name"/><TextBox x:Name="JobName"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Source — Windows" FontWeight="SemiBold" Margin="4,0,0,8"/><Label Content="Local directory"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse" Padding="8,8"/><TextBox x:Name="SourcePath"/></DockPanel><Label Content="File pattern"/><TextBox x:Name="Pattern"/><CheckBox x:Name="Recursive" Content="Include subfolders" Margin="4,8"/><Label Content="File stability wait (seconds)"/><ComboBox x:Name="Stability"/><Label Content="Parallel files"/><ComboBox x:Name="ParallelFiles"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Destination — OpenShift" FontWeight="SemiBold" Margin="4,0,0,8"/><Label Content="Project / Namespace"/><ComboBox x:Name="Namespaces" SelectionChanged="NamespaceChanged"/><Label Content="Pod"/><ComboBox x:Name="JobPods" SelectionChanged="JobPodChanged"/><Label Content="Container"/><ComboBox x:Name="JobContainers"/><Label Content="Destination directory"/><TextBox x:Name="Destination"/><TextBlock Text="Source files are retained. Existing destination files may be overwritten. Uploads are size-verified and retry up to 3 attempts." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,8"/></StackPanel>
</Grid><Label Content="Description (optional)" Margin="0,8,0,0"/><TextBox x:Name="Description" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>

</StackPanel></ScrollViewer></DockPanel></TabItem>
<TabItem Header="Transfers"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="170"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Open folder" Click="OpenFolder"/><TextBlock x:Name="TransferHeading" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="5" Margin="0,8"><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="ActiveCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="QueuedCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="CompletedCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="FailedCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="TotalCount"/></Border></UniformGrid>
<WrapPanel Grid.Row="2"><ComboBox x:Name="StatusFilter" Width="120" SelectedIndex="0" SelectionChanged="TransferFiltersChanged"><ComboBoxItem Content="All"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Queued"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Failed"/><ComboBoxItem Content="Cancelled"/></ComboBox><TextBlock Text="Search" VerticalAlignment="Center" Margin="6,0,2,0"/><TextBox x:Name="FileSearch" Width="145" TextChanged="SearchTransfers" ToolTip="Search files or source paths"/><ComboBox x:Name="TimeFilter" Width="145" SelectedIndex="0" SelectionChanged="TransferFiltersChanged"><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Last 7 days"/></ComboBox><Button Content="Clear history" Click="ClearHistory" Padding="10,8"/><Button Content="Cancel selected" Click="CancelTransfer" Padding="10,8"/><Button Content="Retry selected" Click="RetryTransfer" Padding="10,8"/></WrapPanel>
<ListView x:Name="TransferTable" Grid.Row="3" SelectionChanged="TransferSelected"><ListView.View><GridView><GridViewColumn Header="File name" Width="160" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Source path" Width="160" DisplayMemberBinding="{Binding SourcePath}"/><GridViewColumn Header="Size (bytes)" Width="90" DisplayMemberBinding="{Binding Total}"/><GridViewColumn Header="Progress" Width="190"><GridViewColumn.CellTemplate><DataTemplate><StackPanel><ProgressBar Height="7" Value="{Binding Percentage, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Indeterminate}"/><TextBlock Text="{Binding ProgressText}" FontSize="10"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Speed" Width="85" DisplayMemberBinding="{Binding Speed}"/><GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding State}"/><GridViewColumn Header="Started" Width="140" DisplayMemberBinding="{Binding Started, StringFormat=MM-dd HH:mm:ss}"/><GridViewColumn Header="Completed" Width="140" DisplayMemberBinding="{Binding Completed, StringFormat=MM-dd HH:mm:ss}"/><GridViewColumn Header="Actions" Width="145"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Cancel" Padding="6,3" Click="CancelTransfer" IsEnabled="{Binding CanCancel}"/><Button Content="Retry" Padding="6,3" Click="RetryTransfer"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView>
<TabControl Grid.Row="4" Margin="0,8,0,0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"><TabItem Header="Activity Log"><DockPanel><ComboBox x:Name="LogLevelFilter" DockPanel.Dock="Top" HorizontalAlignment="Right" Width="120" SelectedIndex="0" SelectionChanged="LogLevelChanged"><ComboBoxItem Content="All levels"/><ComboBoxItem Content="INFO"/><ComboBoxItem Content="WARN"/><ComboBoxItem Content="ERROR"/></ComboBox><ListView x:Name="LogTable"><ListView.View><GridView><GridViewColumn Header="Time" Width="75" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss}"/><GridViewColumn Header="Level" Width="65" DisplayMemberBinding="{Binding Level}"/><GridViewColumn Header="Message" Width="650" DisplayMemberBinding="{Binding Message}"/></GridView></ListView.View></ListView></DockPanel></TabItem><TabItem Header="Transfer Details"><TextBox x:Name="TransferDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
</Grid></TabItem></TabControl></Grid>
<TextBlock Grid.Row="2" Text="Monitoring runs while WinOCP is open. Pause stops new dispatch; active transfers finish." Foreground="{DynamicResource MutedBrush}" Margin="4,8,0,0" FontSize="11"/>
</Grid></Window>
