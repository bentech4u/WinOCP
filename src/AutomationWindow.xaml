<Window x:Class="WinOCP.AutomationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOCP — Automation" Width="700" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
<StackPanel Margin="18" Background="{DynamicResource PageBrush}"><TextBlock Text="Automatic file uploads" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ClusterLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12" TextTrimming="CharacterEllipsis"/>
<StackPanel x:Name="SettingsPanel"><Label Content="Automation name"/><TextBox x:Name="JobName"/>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Source — Windows" FontWeight="SemiBold" Margin="4,0,0,10"/><Label Content="Local directory"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse"/><TextBox x:Name="SourcePath"/></DockPanel><Label Content="File pattern" Margin="0,8,0,0"/><TextBox x:Name="Pattern" Text="*.csv"/><CheckBox x:Name="Recursive" Content="Include subfolders (preserve structure)" Margin="4,10"/><Label Content="File stability wait (seconds)"/><ComboBox x:Name="Stability"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Destination — OpenShift" FontWeight="SemiBold" Margin="4,0,0,10"/><Label Content="Project / Namespace"/><ComboBox x:Name="Namespaces" SelectionChanged="NamespaceChanged"/><Label Content="Pod"/><ComboBox x:Name="JobPods" SelectionChanged="JobPodChanged"/><Label Content="Container"/><ComboBox x:Name="JobContainers"/><Label Content="Destination directory"/><TextBox x:Name="Destination" Text="/tmp"/></StackPanel>
</Grid><DockPanel Margin="0,12,0,0"><StackPanel DockPanel.Dock="Left" Width="160"><Label Content="Parallel files"/><ComboBox x:Name="ParallelFiles"/></StackPanel><TextBlock Text="Source files are retained. Existing destination files may be overwritten. Files are size-verified; failed uploads retry up to 3 times." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="16,24,4,0"/></DockPanel></StackPanel>
<TextBlock x:Name="JobStatus" Text="Loading cluster…" TextWrapping="Wrap" Margin="4,14,4,6" Foreground="{DynamicResource MutedBrush}"/>
<TextBox x:Name="JobLog" Height="90" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="TestButton" Content="Test configuration" Click="Test"/><Button x:Name="StartButton" Content="Save &amp; Start" Style="{StaticResource Primary}" Click="StartJob"/><Button x:Name="StopButton" Content="Stop" IsEnabled="False" Click="StopJob"/><Button Content="Close" Click="CloseWindow"/></StackPanel>
</StackPanel></Window>
