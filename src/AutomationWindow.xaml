<Window Icon="/Assets/WinOCP.ico" x:Class="WinOCP.AutomationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinOCP — Automation" Width="1040" Height="790" MinWidth="880" MinHeight="700" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
<Window.Resources>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="10" Margin="0,2" Background="Transparent" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid Margin="14" Background="{DynamicResource PageBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="4,0,0,12"><TextBlock Text="Automatic file uploads" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ClusterLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><Button DockPanel.Dock="Right" Content="+ New Job" Click="NewJob" Padding="10,6" Style="{StaticResource Primary}"/><TextBlock Text="Job Manager" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Search jobs" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,4,0,0"/><TextBox x:Name="JobSearch" TextChanged="SearchJobs" ToolTip="Search jobs"/></StackPanel><TextBlock x:Name="JobCount" DockPanel.Dock="Bottom" Margin="4,10" Foreground="{DynamicResource MutedBrush}"/><ListBox x:Name="JobsList" SelectionChanged="SelectJob" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="11"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="240"/><RowDefinition x:Name="LogDividerRow" Height="0"/><RowDefinition x:Name="LogRow" Height="Auto"/></Grid.RowDefinitions><WrapPanel Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top"><WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="4,1"/></Style></WrapPanel.Resources><Button x:Name="StartButton" Height="34" Margin="4,1" Content="Start" Style="{StaticResource Primary}" Click="StartJob"/><Button x:Name="PauseButton" Content="Pause" Click="PauseJob"/><Button x:Name="StopButton" Content="Stop" Click="StopJob"/></WrapPanel><TabControl x:Name="JobTabs" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="10"><TabItem Header="Job Details">
<DockPanel><StackPanel DockPanel.Dock="Bottom"><DockPanel Margin="0,10,0,0"><StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="Job status" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeState" Text="Stopped" Foreground="{DynamicResource MutedBrush}" Margin="4"/></StackPanel></DockPanel><TextBlock x:Name="JobStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,8"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="TestButton" Content="Test configuration" Click="Test"/><Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" Click="SaveJob"/><Button x:Name="DeleteButton" Content="Delete" Click="DeleteJob"/><Button Content="Close" Click="CloseWindow"/></WrapPanel></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel x:Name="SettingsPanel"><Label Content="Automation name"/><TextBox x:Name="JobName"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8"><StackPanel><TextBlock Text="Source — Windows" FontWeight="SemiBold" Margin="4,0,0,8"/><Label Content="Local directory"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse" Padding="8,8"/><TextBox x:Name="SourcePath"/></DockPanel><WrapPanel VerticalAlignment="Center"><Label Content="File pattern"/><CheckBox x:Name="Recursive" Content="Include subfolders" VerticalAlignment="Center" Margin="12,0,4,0"/></WrapPanel><TextBox x:Name="Pattern"/><Label Content="File stability wait (seconds)"/><ComboBox x:Name="Stability"/><Label Content="Parallel files"/><ComboBox x:Name="ParallelFiles"/></StackPanel></Border>
<Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8"><StackPanel><TextBlock Text="Destination — OpenShift" FontWeight="SemiBold" Margin="4,0,0,8"/><Label Content="Project / Namespace"/><ComboBox x:Name="Namespaces" SelectionChanged="NamespaceChanged"/><Label Content="Pod"/><ComboBox x:Name="JobPods" SelectionChanged="JobPodChanged"/><Label Content="Container"/><ComboBox x:Name="JobContainers"/><Label Content="Destination directory"/><TextBox x:Name="Destination"/><TextBlock Text="Source handling follows Completion policy. Existing destination files may be overwritten. Verification follows the Completion policy. Uploads retry up to 3 attempts." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="4,8"/></StackPanel></Border>
</Grid><Label Content="Description (optional)" Margin="0,8,0,0"/><TextBox x:Name="Description" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>

</StackPanel></ScrollViewer></DockPanel></TabItem><TabItem Header="Transfers"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Open remote folder" ToolTip="Open this job destination in the main remote file pane" Click="OpenFolder"/><TextBlock x:Name="TransferHeading" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="5" Margin="0,8"><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="ActiveCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="QueuedCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="CompletedCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="FailedCount"/></Border><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="3"><TextBlock x:Name="TotalCount"/></Border></UniformGrid>
<WrapPanel Grid.Row="2"><ComboBox x:Name="StatusFilter" Width="120" SelectedIndex="0" SelectionChanged="TransferFiltersChanged"><ComboBoxItem Content="All"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Queued"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Failed"/><ComboBoxItem Content="Cancelled"/></ComboBox><TextBlock Text="Search" VerticalAlignment="Center" Margin="6,0,2,0"/><TextBox x:Name="FileSearch" Width="145" TextChanged="SearchTransfers" ToolTip="Search files or source paths"/><ComboBox x:Name="TimeFilter" Width="145" SelectedIndex="0" SelectionChanged="TransferFiltersChanged"><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Last 7 days"/></ComboBox><Button Content="Clear history" Click="ClearHistory" Padding="10,8"/><Button Content="Cancel selected" Click="CancelTransfer" Padding="10,8"/><Button Content="Retry selected" Click="RetryTransfer" Padding="10,8"/></WrapPanel>
<ListView x:Name="TransferTable" Grid.Row="3"><ListView.View><GridView><GridViewColumn Header="File name" Width="160" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Source path" Width="160" DisplayMemberBinding="{Binding SourcePath}"/><GridViewColumn Header="Size (bytes)" Width="90" DisplayMemberBinding="{Binding Total}"/><GridViewColumn Header="Progress" Width="190"><GridViewColumn.CellTemplate><DataTemplate><StackPanel><ProgressBar Height="7" Value="{Binding Percentage, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Indeterminate}"/><TextBlock Text="{Binding ProgressText}" FontSize="10"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="Speed" Width="85" DisplayMemberBinding="{Binding Speed}"/><GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding State}"/><GridViewColumn Header="Started" Width="140" DisplayMemberBinding="{Binding Started, StringFormat=MM-dd HH:mm:ss}"/><GridViewColumn Header="Completed" Width="140" DisplayMemberBinding="{Binding Completed, StringFormat=MM-dd HH:mm:ss}"/><GridViewColumn Header="Actions" Width="145"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Cancel" Padding="6,3" Click="CancelTransfer" IsEnabled="{Binding CanCancel}"/><Button Content="Retry" Padding="6,3" Click="RetryTransfer"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView>
</Grid></TabItem><TabItem Header="Completion"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock Text="Completion policy" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,12"/><StackPanel x:Name="CompletionSettings"><CheckBox x:Name="VerifySha256" Content="Verify file contents with SHA-256" Margin="4,8"/><TextBlock Text="Compares the uploaded bytes with the remote file contents before recording success. Requires sha256sum inside the container. When unchecked, only file size is verified." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,4,4,16"/><Label Content="After successful transfer"/><ComboBox x:Name="CompletionAction"><ComboBoxItem Content="Keep source files"/><ComboBoxItem Content="Move to archive"/></ComboBox><Label Content="Archive directory (outside the source folder)"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseArchive"/><TextBox x:Name="ArchiveDirectory"/></DockPanel><TextBlock Text="Archive preserves subfolders and keeps existing archive files. If archiving fails, the verified source stays in place and a warning is logged." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,4,4,16"/><TextBlock Text="Completed files" FontWeight="SemiBold" Margin="4"/><TextBlock Text="Unchanged completed files are skipped across restarts. Files with a changed size or last-modified time are uploaded again. Keep the automation receipt files beside WinOCP to preserve this history." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,4,4,16"/></StackPanel><Button Content="Save completion policy" Click="SaveJob" HorizontalAlignment="Left" Style="{StaticResource Primary}"/></StackPanel></ScrollViewer></TabItem></TabControl>
<GridSplitter x:Name="LogDivider" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderBrush}" Visibility="Collapsed" ToolTip="Drag to resize Activity log"/>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="10"><Grid><Expander x:Name="ActivityPanel" IsExpanded="False" Expanded="ActivityExpanded" Collapsed="ActivityCollapsed" Foreground="{DynamicResource TextBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Expander.Header><TextBlock Text="Activity log" Height="44" VerticalAlignment="Center" Padding="0,13,0,0"/></Expander.Header><DockPanel Margin="0,8,0,0"><ListView x:Name="LogTable"><ListView.View><GridView><GridViewColumn Header="Time" Width="75" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss}"/><GridViewColumn Header="Level" Width="65" DisplayMemberBinding="{Binding Level}"/><GridViewColumn Header="Message" Width="650" DisplayMemberBinding="{Binding Message}"/></GridView></ListView.View></ListView></DockPanel></Expander><ComboBox x:Name="LogLevelFilter" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" SelectedIndex="0" SelectionChanged="LogLevelChanged"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=ActivityPanel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBoxItem Content="All levels"/><ComboBoxItem Content="INFO"/><ComboBoxItem Content="WARN"/><ComboBoxItem Content="ERROR"/></ComboBox></Grid></Border></Grid></Grid>
<TextBlock Grid.Row="2" Text="Monitoring runs while WinOCP is open. Pause stops new dispatch; active transfers finish." Foreground="{DynamicResource MutedBrush}" Margin="4,8,0,0" FontSize="11"/>
</Grid></Window>
